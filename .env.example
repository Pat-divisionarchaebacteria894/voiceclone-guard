# ── VoiceClone Guard — Environment Variables ────────────────────────────────

# ── Backend ──────────────────────────────────────────────────────────────────
# SQLite DB path (relative to backend container)
DATABASE_URL=sqlite:///./data/voiceguard.db

# Directory for uploaded audio files
UPLOAD_DIR=./data/uploads

# Directory for cached ML model weights
MODEL_CACHE_DIR=./data/models

# Max upload size in MB (default 25)
MAX_FILE_SIZE_MB=25

# CORS allowed origins (comma-separated for multiple)
CORS_ORIGINS=http://localhost:3000

# ── ML Model (optional) ──────────────────────────────────────────────────────
# Set to "true" to download and use a HuggingFace transformer model.
# Spectral analysis is always used regardless of this setting.
# First run will download model weights (~400 MB) — requires internet.
USE_TRANSFORMER_MODEL=false

# HuggingFace model ID for audio classification (deepfake detection)
# Examples:
#   MelissaAzoulay/deepfake_voice_detector
#   DunnBC22/wav2vec2-base-voice_deepfake_detection
HF_MODEL_ID=

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
